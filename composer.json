{
    "name": "omnibuy/omnibuy",
    "description": "OmniBuy online marketplace",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "OmniBuy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:functional": "phpunit --testsuite Functional"
    },
    "config": {
        "sort-packages": true
    }
}
